# =======================================================
# Facebook Content Automation & Scheduling Platform
# Environment Configuration
# =======================================================

# App Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
DEMO_MODE=true

# Security & Sessions
SESSION_SECRET=change-this-to-a-super-secret-hex-token-min-32-chars-abc12345
OWNER_USERNAME=admin
OWNER_PASSWORD=admin123456

# Meta / Facebook Graph API Credentials (for Live Mode)
# Create App at https://developers.facebook.com
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_REDIRECT_URI=http://localhost:3000/api/facebook/callback
META_GRAPH_VERSION=v20.0

# Database Configuration (Leave empty to use built-in local persistent store)
DATABASE_URL=
# Example PostgreSQL: postgresql://postgres:postgres@localhost:5432/fb_autopilot

# Redis Configuration (Optional for scaling workers)
REDIS_URL=redis://localhost:6379

# Storage Configuration (local | s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BUCKET=fb-media-assets
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=

# Timezone (Default: Asia/Karachi)
DEFAULT_TIMEZONE=Asia/Karachi

# Worker & Scheduling Defaults
MAX_CONCURRENT_JOBS=3
DEFAULT_RETRY_COUNT=3
DEFAULT_POSTING_DELAY_MINUTES=60
